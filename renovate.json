{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Updates arrive as reviewed pull requests, and only for releases at least seven days old, since poisoned releases are usually found and pulled within days. Images stay named by digest.",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "internalChecksAsSuccess": true,
  "pinDigests": true,
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "7 days"
  },
  "lockFileMaintenance": {
    "enabled": true
  }
}
